# 조건 C 전용 이미지: ddi-runtime + 예측 서버 + ddi 패키지 (domain-specific ACI).
# B는 ddi-runtime 을 그대로 쓴다. 프로젝트 루트에서 빌드:
#   docker build -f docker/Dockerfile.specialist -t ddi-specialist .
FROM ddi-runtime

COPY server/predictor.py server/app.py /opt/ddi-server/
# 환경 ①(OpenHands)에서 import 할 패키지. 자동 import 방식은 OpenHands 연결 단계에서 정함
COPY ddi /opt/ddi-skill/ddi
ENV DDI_SERVER_URL=http://127.0.0.1:8765

# 작업 폴더 /opt/DSN-DDI 에서 서버 실행 (원 data_preprocessing 이 상대 경로로 데이터를 읽음)
CMD ["python", "/opt/ddi-server/app.py"]
